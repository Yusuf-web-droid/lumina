{
  "name": "lumina",
  "version": "0.3.0",
  "description": "A minimal desktop web browser built on Electron",
  "main": "./out/main/index.js",
  "author": "ali.khan@sgmc.ac.uk",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "start": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "electron": "43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
